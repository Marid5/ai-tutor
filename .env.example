# Copy to .env and adjust. Every variable is optional; the defaults are shown.

# Where the SQLite database lives.
# DATABASE_PATH=data/ai_tutor.db

# Directory with the course content (YAML programs).
# CONTENT_DIR=content

# Directory with the built frontend.
# STATIC_DIR=static

# "open" lets anyone register through the API; anything else keeps registration closed.
REGISTRATION=closed

# Send the session cookie over HTTPS only. Set to false only for plain-HTTP local use.
COOKIE_SECURE=true

# Trust X-Forwarded-For from the reverse proxy. Keep true behind Caddy/nginx;
# otherwise every visitor shares one rate-limit bucket.
TRUST_PROXY=true

# Rate limits.
# REGISTER_LIMIT_PER_HOUR=5
# LOGIN_IP_LIMIT=20
# LOGIN_USER_FAIL_LIMIT=10

# Build identifier shown by the health endpoint.
# GIT_SHA=dev
